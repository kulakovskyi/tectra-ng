{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    "paths": {
      "@tectra-ng/tokens": ["./packages/tokens/src/index.ts"],
      "@tectra-ng/themes": ["./packages/themes/src/index.ts"],
      "@tectra-ng/icons": ["./packages/icons/src/index.ts"],
      "@tectra-ng/brand-icons": ["./packages/brand-icons/src/index.ts"],
      "@tectra-ng/core/*": ["./packages/core/*/index.ts"],
      "@tectra-ng/ui/*": ["./packages/ui/*/index.ts"],
      "@tectra-ng/blocks/*": ["./packages/blocks/*/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "exclude": ["node_modules", "tmp"]
}
