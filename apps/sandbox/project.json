{
  "name": "sandbox",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/sandbox/src",
  "tags": ["type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/sandbox",
        "index": "apps/sandbox/src/index.html",
        "browser": "apps/sandbox/src/main.ts",
        "tsConfig": "apps/sandbox/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "styles": ["node_modules/@angular/cdk/overlay-prebuilt.css"],
        "optimization": false,
        "sourceMap": true
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": { "port": 4301, "buildTarget": "sandbox:build" }
    }
  }
}
