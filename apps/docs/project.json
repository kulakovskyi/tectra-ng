{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "docs",
  "sourceRoot": "apps/docs/src",
  "tags": ["type:app"],
  "targets": {
    "registry": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/registry-builder/build-registry.mjs" }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-app"],
      "cache": false,
      "options": { "command": "node tools/site-files/build-site-files.mjs" }
    },
    "build-app": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["registry"],
      "options": {
        "outputPath": "dist/apps/docs",
        "index": "apps/docs/src/index.html",
        "browser": "apps/docs/src/main.ts",
        "server": "apps/docs/src/main.server.ts",
        "outputMode": "static",
        "tsConfig": "apps/docs/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "styles": ["apps/docs/src/styles.scss"],
        "assets": [{ "glob": "**/*", "input": "apps/docs/public" }]
      },
      "configurations": {
        "production": {
          "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": true },
          "outputHashing": "all",
          "budgets": [{ "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" }]
        },
        "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "dependsOn": ["registry"],
      "options": { "port": 4300 },
      "configurations": {
        "production": { "buildTarget": "docs:build-app:production" },
        "development": { "buildTarget": "docs:build-app:development" }
      },
      "defaultConfiguration": "development"
    }
  }
}
