{
  "name": "tectra-ng",
  "private": true,
  "scripts": {
    "registry": "node tools/registry-builder/build-registry.mjs",
    "docs": "npm run registry && nx serve docs",
    "docs:build": "npm run registry && nx build docs",
    "sandbox": "nx serve sandbox",
    "landing-shots": "node tools/landing-shots/shoot.mjs",
    "build:packages": "nx run-many -t build -p tokens themes core icons brand-icons flags qr ui editor code-editor charts utils blocks tectra-ng",
    "icons": "node tools/icons/build-icons.mjs && node tools/icons/build-brand-icons.mjs",
    "flags": "node tools/flags/build-flags.mjs",
    "export-font": "node tools/export-font/build-export-font.mjs",
    "brand": "node tools/brand/build-brand-images.mjs",
    "test": "nx run-many -t test -p themes core icons flags qr ui editor code-editor charts utils blocks",
    "e2e": "nx e2e visual",
    "lint": "eslint .",
    "format:examples": "prettier --write \"apps/docs/src/content/**/*.example.ts\""
  },
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "prosemirror-model": "1.25.13",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.5",
    "prosemirror-view": "1.42.9",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.2.6",
    "@angular-devkit/schematics": "22.2.6",
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@angular/language-service": "22.2.5",
    "@angular/platform-server": "^22.2.5",
    "@angular/ssr": "^22.2.6",
    "@axe-core/playwright": "^4.14.0",
    "@nx/angular": "23.2.1",
    "@nx/devkit": "23.2.1",
    "@nx/eslint": "^23.2.1",
    "@nx/eslint-plugin": "^23.2.1",
    "@nx/js": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "^1.63.0",
    "@schematics/angular": "22.2.6",
    "angular-eslint": "^22.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "flag-icons": "^7.5.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^26.1.0",
    "marked": "^16.0.0",
    "ng-packagr": "22.2.6",
    "nx": "23.2.1",
    "prettier": "^3.9.10",
    "sass": "^1.89.0",
    "simple-icons": "^16.36.0",
    "svgo": "^4.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
