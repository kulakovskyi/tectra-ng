{
  "name": "tectra-ng",
  "private": true,
  "scripts": {
    "registry": "node tools/registry-builder/build-registry.mjs",
    "docs": "npm run registry && nx serve docs",
    "docs:build": "npm run registry && nx build docs",
    "sandbox": "nx serve sandbox",
    "landing-shots": "node tools/landing-shots/shoot.mjs",
    "build:packages": "nx run-many -t build -p tokens themes core icons brand-icons flags qr ui editor code-editor charts utils blocks tectra-ng && node tools/npm-package-files.mjs && node tools/api-docs/document-types.mjs --check --strict",
    "icons": "node tools/icons/build-icons.mjs && node tools/icons/build-brand-icons.mjs && node tools/icons/build-icon-defaults.mjs",
    "icons:defaults": "node tools/icons/build-icon-defaults.mjs",
    "themes:groups": "node tools/themes/build-token-groups.mjs",
    "flags": "node tools/flags/build-flags.mjs",
    "export-font": "node tools/export-font/build-export-font.mjs",
    "brand": "node tools/brand/build-brand-images.mjs",
    "test": "nx run-many -t test -p themes core icons flags qr ui editor code-editor charts utils blocks tectra-ng",
    "e2e": "nx e2e visual",
    "e2e:ng-add": "node e2e/ng-add/prepare.mjs && playwright test -c e2e/ng-add/playwright.config.ts",
    "size": "node tools/bundle-size/check-bundle-size.mjs",
    "size:update": "node tools/bundle-size/check-bundle-size.mjs --update",
    "lint": "eslint .",
    "coverage:report": "node tools/coverage/coverage-report.mjs",
    "links": "node tools/link-check/check-links.mjs",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "format:examples": "prettier --write \"apps/docs/src/content/**/*.example.ts\""
  },
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "prosemirror-model": "1.25.13",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.7",
    "prosemirror-view": "1.43.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.3.0",
    "@angular-devkit/schematics": "22.3.0",
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/language-service": "22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@nx/angular": "23.3.2",
    "@nx/devkit": "23.3.2",
    "@nx/eslint": "^23.2.1",
    "@nx/eslint-plugin": "^23.3.2",
    "@nx/js": "23.3.2",
    "@nx/workspace": "23.3.2",
    "@playwright/test": "^1.65.1",
    "@schematics/angular": "22.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "^22.8.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.3",
    "flag-icons": "^7.6.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^26.1.0",
    "marked": "^16.0.0",
    "ng-packagr": "22.3.0",
    "nx": "23.3.2",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "simple-icons": "^16.38.0",
    "svgo": "^4.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
