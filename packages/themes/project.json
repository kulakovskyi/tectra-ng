{
  "name": "themes",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/themes",
  "tags": [
    "pkg:themes"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/packages/themes"
      ],
      "options": {
        "project": "packages/themes/ng-package.json",
        "tsConfig": "packages/themes/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "sandbox:build",
        "tsConfig": "packages/themes/tsconfig.spec.json",
        "runner": "vitest",
        "watch": false
      }
    }
  }
}
