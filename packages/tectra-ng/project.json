  "sourceRoot": "packages/tectra-ng",
  "tags": ["pkg:umbrella"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/tectra-ng"],
