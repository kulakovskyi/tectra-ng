{
  "name": "tectra-ng",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/tectra-ng",
  "tags": ["pkg:umbrella"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/tectra-ng"],
      "options": {
        "parallel": false,
        "commands": [
          "rm -rf dist/packages/tectra-ng && mkdir -p dist/packages/tectra-ng/schematics/ng-add",
          "cp packages/tectra-ng/package.json packages/tectra-ng/README.md packages/tectra-ng/index.d.ts LICENSE dist/packages/tectra-ng/",
          "cp packages/tectra-ng/schematics/collection.json packages/tectra-ng/schematics/migrations.json dist/packages/tectra-ng/schematics/ && cp packages/tectra-ng/schematics/ng-add/schema.json dist/packages/tectra-ng/schematics/ng-add/",
          "tsc -p packages/tectra-ng/tsconfig.schematics.json"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/tectra-ng"],
      "options": {
        "command": "vitest run -c packages/tectra-ng/vitest.config.mts"
      }
    }
  }
}
