{
  "name": "editor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/editor",
  "tags": ["pkg:editor"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/packages/editor"],
      "options": {
        "project": "packages/editor/ng-package.json",
        "tsConfig": "packages/editor/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "sandbox:build",
        "tsConfig": "packages/editor/tsconfig.spec.json",
        "runner": "vitest",
        "watch": false,
        "coverage": true,
        "coverageInclude": ["packages/editor/**/*.ts"],
        "coverageExclude": ["**/*.spec.ts", "**/index.ts", "**/test-setup.ts", "**/generated/**"],
        "coverageReporters": ["text-summary", "json-summary", "lcovonly"],
        "coverageThresholds": {
          "statements": 95,
          "branches": 95,
          "functions": 95,
          "lines": 95
        }
      },
      "outputs": ["{workspaceRoot}/coverage/editor"]
    }
  }
}
