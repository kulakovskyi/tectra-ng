{
  "name": "utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/utils",
  "tags": ["pkg:utils"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/packages/utils"],
      "options": {
        "project": "packages/utils/ng-package.json",
        "tsConfig": "packages/utils/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "sandbox:build",
        "tsConfig": "packages/utils/tsconfig.spec.json",
        "runner": "vitest",
        "watch": false
      }
    }
  }
}
