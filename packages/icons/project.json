{
  "name": "icons",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/icons",
  "tags": ["pkg:icons"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/packages/icons"],
      "options": {
        "project": "packages/icons/ng-package.json",
        "tsConfig": "packages/icons/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "sandbox:build",
        "tsConfig": "packages/icons/tsconfig.spec.json",
        "runner": "vitest",
        "watch": false,
        "coverage": true,
        "coverageInclude": ["packages/icons/**/*.ts"],
        "coverageExclude": ["**/*.spec.ts", "**/index.ts", "**/test-setup.ts", "**/generated/**"],
        "coverageReporters": ["text-summary", "json-summary", "lcovonly"],
        "coverageThresholds": {
          "statements": 95,
          "branches": 95,
          "functions": 95,
          "lines": 95
        }
      },
      "outputs": ["{workspaceRoot}/coverage/icons"]
    }
  }
}
